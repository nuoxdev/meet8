# Local development. Replace owner with your verified email before shared use.
NODE_ENV=development
MEET8_OWNER_EMAIL=owner@example.com
MEET8_BASE_URL=http://localhost:5173
PORT=4100
# docker compose -f compose.dev.yaml up -d
DATABASE_URL=postgresql://meet8:meet8-local-only@127.0.0.1:5448/meet8
# Development codes are displayed in the UI; never enabled in production.
MEET8_DEV_MAIL=true
# MEET8_EPHEMERAL=true permits disposable storage if DATABASE_URL is absent.
MEET8_EPHEMERAL=false
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_MODE=self-hosted
# Production: set NODE_ENV=production, HTTPS base URL, real SMTP and Cloud media.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Meet8 <meetings@example.com>
# LIVEKIT_MODE=cloud
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# POSTGRES_PASSWORD=replace-with-long-url-safe-password

# Direct-server release settings (4198 is available on the current Desk8 server).
MEET8_BIND_PORT=4198
# MEET8_IMAGE=meet8:replace-with-release-commit
